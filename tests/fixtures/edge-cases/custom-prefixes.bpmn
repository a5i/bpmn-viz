<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
      xmlns:x="http://www.omg.org/spec/BPMN/20100524/DI"
      xmlns:d="http://www.omg.org/spec/DD/20100524/DC"
      xmlns:w="http://www.omg.org/spec/DD/20100524/DI"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      id="Defs_PrefixFree" targetNamespace="http://example.test/prefix-free">
  <!-- AC-01: arbitrary prefixes; AC-01 xsi:type on abstract elements -->
  <process id="P1">
    <zzz xmlns="http://vendor.example/ignore" junk="1"/>
    <startEvent id="S1" name="start">
      <outgoing>F1</outgoing>
    </startEvent>
    <gateway id="G1" xsi:type="exclusiveGateway" name="decide" default="F3">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
      <outgoing>F3</outgoing>
    </gateway>
    <userTask id="T1" name="check form">
      <incoming>F2</incoming>
      <outgoing>F4</outgoing>
    </userTask>
    <task id="T2" name="archive">
      <incoming>F3</incoming>
      <outgoing>F4</outgoing>
    </task>
    <endEvent id="E1">
      <incoming>F4</incoming>
    </endEvent>
    <sequenceFlow id="F1" sourceRef="S1" targetRef="G1"/>
    <sequenceFlow id="F2" name="valid" sourceRef="G1" targetRef="T1">
      <conditionExpression xsi:type="tFormalExpression" xmlns:t="http://www.omg.org/spec/BPMN/20100524/MODEL">form ok</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="F3" name="fallback" sourceRef="G1" targetRef="T2"/>
    <sequenceFlow id="F4" sourceRef="T1" targetRef="E1"/>
    <laneSet id="LS1">
      <lane id="L1" name="Clerks">
        <flowNodeRef>T1</flowNodeRef>
        <flowNodeRef>T2</flowNodeRef>
      </lane>
    </laneSet>
    <textAnnotation id="TA1">
      <text>Fallback path archives the request</text>
    </textAnnotation>
  </process>
  <x:BPMNDiagram id="D1">
    <x:BPMNPlane id="Pl1" bpmnElement="P1">
      <x:BPMNShape id="S1_di" bpmnElement="S1">
        <d:Bounds x="40" y="100" width="36" height="36"/>
      </x:BPMNShape>
      <x:BPMNShape id="G1_di" bpmnElement="G1">
        <d:Bounds x="140" y="95" width="50" height="50"/>
      </x:BPMNShape>
      <x:BPMNShape id="T1_di" bpmnElement="T1">
        <d:Bounds x="260" y="50" width="100" height="80"/>
      </x:BPMNShape>
      <x:BPMNShape id="T2_di" bpmnElement="T2">
        <d:Bounds x="260" y="170" width="100" height="80"/>
      </x:BPMNShape>
      <x:BPMNShape id="E1_di" bpmnElement="E1">
        <d:Bounds x="430" y="118" width="36" height="36"/>
      </x:BPMNShape>
      <x:BPMNShape id="L1_di" bpmnElement="L1" isHorizontal="false">
        <d:Bounds x="220" y="20" width="30" height="360"/>
      </x:BPMNShape>
      <x:BPMNShape id="TA1_di" bpmnElement="TA1">
        <d:Bounds x="260" y="290" width="180" height="40"/>
      </x:BPMNShape>
      <x:BPMNEdge id="F1_di" bpmnElement="F1">
        <w:waypoint x="76" y="118"/><w:waypoint x="140" y="120"/>
      </x:BPMNEdge>
      <x:BPMNEdge id="F2_di" bpmnElement="F2">
        <w:waypoint x="165" y="95"/><w:waypoint x="165" y="90"/><w:waypoint x="260" y="90"/>
      </x:BPMNEdge>
      <x:BPMNEdge id="F3_di" bpmnElement="F3">
        <w:waypoint x="165" y="145"/><w:waypoint x="165" y="210"/><w:waypoint x="260" y="210"/>
      </x:BPMNEdge>
      <x:BPMNEdge id="F4_di" bpmnElement="F4">
        <w:waypoint x="360" y="130"/><w:waypoint x="430" y="136"/>
      </x:BPMNEdge>
    </x:BPMNPlane>
  </x:BPMNDiagram>
</definitions>
