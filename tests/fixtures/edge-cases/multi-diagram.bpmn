<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Defs_Multi" targetNamespace="http://example.test/multi">
  <!-- AC-06: two diagrams; the second highlights a different node -->
  <process id="Process_Multi" isExecutable="false">
    <startEvent id="Start_M">
      <outgoing>Flow_M1</outgoing>
    </startEvent>
    <parallelGateway id="Gateway_P" name="fork">
      <incoming>Flow_M1</incoming>
      <outgoing>Flow_M2</outgoing>
      <outgoing>Flow_M3</outgoing>
    </parallelGateway>
    <task id="Task_A" name="left"/>
    <task id="Task_B" name="right"/>
    <endEvent id="End_M"/>
    <sequenceFlow id="Flow_M1" sourceRef="Start_M" targetRef="Gateway_P"/>
    <sequenceFlow id="Flow_M2" sourceRef="Gateway_P" targetRef="Task_A"/>
    <sequenceFlow id="Flow_M3" sourceRef="Gateway_P" targetRef="Task_B"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_First">
    <bpmndi:BPMNPlane id="Plane_First" bpmnElement="Process_Multi">
      <bpmndi:BPMNShape id="Start_M_di" bpmnElement="Start_M">
        <dc:Bounds x="60" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_P_di" bpmnElement="Gateway_P">
        <dc:Bounds x="160" y="115" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_di" bpmnElement="Task_A">
        <dc:Bounds x="290" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_B_di" bpmnElement="Task_B">
        <dc:Bounds x="290" y="190" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_M1_di" bpmnElement="Flow_M1">
        <di:waypoint x="96" y="138"/>
        <di:waypoint x="160" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M2_di" bpmnElement="Flow_M2">
        <di:waypoint x="185" y="115"/>
        <di:waypoint x="185" y="100"/>
        <di:waypoint x="290" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_M3_di" bpmnElement="Flow_M3">
        <di:waypoint x="185" y="165"/>
        <di:waypoint x="185" y="230"/>
        <di:waypoint x="290" y="230"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="Diagram_Second" name="Overview">
    <bpmndi:BPMNPlane id="Plane_Second" bpmnElement="Process_Multi">
      <bpmndi:BPMNShape id="Task_A_di_2" bpmnElement="Task_A">
        <dc:Bounds x="500" y="60" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_B_di_2" bpmnElement="Task_B">
        <dc:Bounds x="500" y="190" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_M_di_2" bpmnElement="End_M">
        <dc:Bounds x="660" y="120" width="36" height="36"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
